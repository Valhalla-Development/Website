# Same Mongo as the API. Collection is `apiKeys`.
MongoUri=

# Discord OAuth app (identify). Redirect must match this exactly.
# Production: https://valhalladev.org/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# At least 32 characters. Signs the session cookie and wraps keys at rest.
SESSION_SECRET=
