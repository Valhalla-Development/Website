{
    "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
    "extends": ["ultracite/core", "ultracite/next"],
    "linter": {
      "rules": {
        "suspicious": {
          "noConsole": "off"
        },
        "correctness": {
          "useExhaustiveDependencies": "off"
        }
      }
    },
    "javascript": {
      "formatter": {
        "indentWidth": 4,
        "lineWidth": 100
      }
    }
  }